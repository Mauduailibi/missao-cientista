rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function rootEmail() {
      return 'mauricio.neto@edu.udesc.br';
    }

    function signedIn() {
      return request.auth != null;
    }

    function isRoot() {
      return signedIn() && request.auth.token.email == rootEmail();
    }

    function userDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Qualquer usuário ativo do painel (ADMIN ou LEITOR)
    function isMember() {
      return isRoot() || (
        signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && userDoc().data.active == true
      );
    }

    // Documentos antigos sem `role` foram criados como administradores
    function isAdmin() {
      return isRoot() || (isMember() && userDoc().data.get('role', 'admin') == 'admin');
    }

    function formOpen() {
      return get(/databases/$(database)/documents/settings/form).data.open == true;
    }

    function shortText(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function validParticipants(list) {
      return list is list
        && list.size() >= 1
        && list.size() <= 5
        && shortText(list[0], 200)
        && (list.size() < 2 || shortText(list[1], 200))
        && (list.size() < 3 || shortText(list[2], 200))
        && (list.size() < 4 || shortText(list[3], 200))
        && (list.size() < 5 || shortText(list[4], 200));
    }

    function municipiosSC() {
