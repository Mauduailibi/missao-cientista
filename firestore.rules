        'São Ludgero',
        'São Martinho',
        'São Miguel da Boa Vista',
        'São Miguel do Oeste',
        'São Pedro de Alcântara',
        'Saudades',
        'Schroeder',
        'Seara',
        'Serra Alta',
        'Siderópolis',
        'Sombrio',
        'Sul Brasil',
        'Taió',
        'Tangará',
        'Tigrinhos',
        'Tijucas',
        'Timbé do Sul',
        'Timbó',
        'Timbó Grande',
        'Três Barras',
        'Treviso',
        'Treze de Maio',
        'Treze Tílias',
        'Trombudo Central',
        'Tubarão',
        'Tunápolis',
        'Turvo',
        'União do Oeste',
        'Urubici',
        'Urupema',
        'Urussanga',
        'Vargeão',
        'Vargem',
        'Vargem Bonita',
        'Vidal Ramos',
        'Videira',
        'Vitor Meireles',
        'Witmarsum',
        'Xanxerê',
        'Xavantina',
        'Xaxim',
        'Zortéa'
      ];
    }

    function validInscricao(data) {
      return data.keys().hasOnly([
          'participantes', 'orientadorNome', 'orientadorEmail', 'orientadorTelefone',
          'instituicao', 'nivel', 'municipio', 'titulo', 'resumo', 'cienciaDelas',
          'energiaEletrica', 'espacoEspecial', 'autorizaImagem', 'createdAt'
        ])
        && data.keys().hasAll([
          'participantes', 'orientadorNome', 'orientadorEmail', 'orientadorTelefone',
          'instituicao', 'nivel', 'municipio', 'titulo', 'resumo', 'cienciaDelas',
          'energiaEletrica', 'espacoEspecial', 'autorizaImagem', 'createdAt'
        ])
        && validParticipants(data.participantes)
        && shortText(data.orientadorNome, 200)
        && shortText(data.orientadorEmail, 200)
        && data.orientadorEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.orientadorTelefone is string
        && data.orientadorTelefone.matches('^\\([0-9]{2}\\) [0-9]{5}-[0-9]{4}$')
        && shortText(data.instituicao, 300)
        && data.nivel in ['infantil', 'fundamental', 'medio']
        && data.municipio in municipiosSC()
        && shortText(data.titulo, 300)
        && shortText(data.resumo, 2500)
        && data.cienciaDelas is bool
        && data.energiaEletrica is bool
        && data.espacoEspecial is string && data.espacoEspecial.size() <= 1000
        && data.autorizaImagem == true
        && data.createdAt == request.time;
    }

    match /settings/form {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['open', 'updatedAt', 'updatedBy'])
        && request.resource.data.open is bool;
    }

    match /inscricoes/{id} {
      allow create: if formOpen() && validInscricao(request.resource.data);
      allow read: if isMember();
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);

      // Admin cria um novo login (ou o raiz cria o próprio documento no bootstrap)
      allow create: if (isAdmin() || (isRoot() && request.auth.uid == uid))
        && request.resource.data.keys().hasOnly(['email', 'role', 'active', 'mustChangePassword', 'createdAt', 'createdBy'])
        && request.resource.data.email is string
        && request.resource.data.get('role', 'admin') in ['admin', 'leitor']
        && request.resource.data.active is bool
        && request.resource.data.mustChangePassword is bool;

      // Admin exclui/reativa ou muda o tipo de outro usuário (nunca de si mesmo nem do raiz)
      allow update: if (
          isAdmin()
          && request.auth.uid != uid
          && resource.data.email != rootEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'role'])
          && request.resource.data.active is bool
          && request.resource.data.get('role', 'admin') in ['admin', 'leitor']
        ) || (
          // O próprio usuário conclui a troca de senha obrigatória
          signedIn()
          && request.auth.uid == uid
          && resource.data.mustChangePassword == true
          && request.resource.data.mustChangePassword == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        );

      allow delete: if false;
    }
  }
}
